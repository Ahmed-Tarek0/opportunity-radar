APP_ENV=development
DEMO_MODE=true
DEFAULT_TIMEZONE=Africa/Cairo
DATABASE_URL=sqlite:///./data/opportunity_radar.db

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ENABLE_SEMANTIC_MATCHING=true
CV_MAX_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=15
MAX_PAGES_PER_SOURCE=2
MAX_CONCURRENT_SOURCE_REQUESTS=3
JOB_LOOKBACK_DAYS=7

ENABLE_LINKEDIN_SOURCE=true
ENABLE_WUZZUF_SOURCE=true
ENABLE_REMOTEOK_SOURCE=true
ENABLE_GREENHOUSE_SOURCE=false
ENABLE_LEVER_SOURCE=false
ENABLE_ADZUNA_SOURCE=false

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARD_SLUGS=
LEVER_COMPANY_SLUGS=
